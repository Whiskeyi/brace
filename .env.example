# Brace stores model settings and API keys from the desktop Settings panel.
# These variables are optional fallbacks for source development and CI.

# Supported provider IDs: bailian-payg, bailian-coding-plan,
# minimax-cn-token-plan, minimax-global-token-plan, kimi-code, deepseek,
# glm-payg, glm-coding-plan, custom.
LLM_PROVIDER=bailian-payg
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-model-api-key
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096

# Agent guardrails.
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_TOOL_CALLS=48
AGENT_MAX_TOOL_CONCURRENCY=4
AGENT_TOOL_TIMEOUT_MS=30000
AGENT_REQUEST_TIMEOUT_MS=600000
AGENT_MAX_HISTORY_MESSAGES=40
AGENT_CONTEXT_WINDOW_TOKENS=32768

# Local process boundary. Values are exact executable names. Write and execute
# tools still require interactive approval.
DESKTOP_ALLOWED_EXECUTABLES=git,node,npm,pnpm,npx,yarn,bun,python,python3,pytest,cargo,go,make
DESKTOP_ENV_ALLOWLIST=PATH,LANG,LC_ALL
