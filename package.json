{
  "name": "brace",
  "version": "0.1.0",
  "private": true,
  "main": "dist-desktop/main.cjs",
  "author": "Whiskeyi",
  "license": "MIT",
  "description": "Local-first Electron coding agent with a provider-neutral runtime.",
  "keywords": [
    "ai",
    "coding-agent",
    "desktop",
    "developer-tools",
    "electron",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whiskeyi/brace.git"
  },
  "bugs": {
    "url": "https://github.com/Whiskeyi/brace/issues"
  },
  "homepage": "https://github.com/Whiskeyi/brace#readme",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm desktop:dev",
    "build": "pnpm desktop:build",
    "start": "electron .",
    "dist": "pnpm desktop:dist",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "pnpm desktop:build && electron .",
    "desktop:dist": "pnpm desktop:build && node scripts/package-desktop.mjs",
    "docs:check": "node scripts/check-readme-parity.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "6.46.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "^20.2.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "^43.3.0",
    "esbuild": "^0.28.1",
    "eslint": "9.39.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.7.0"
}
