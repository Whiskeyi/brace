# Desktop mode can save the LLM_* values from its model settings UI; these
# variables remain the source-development/CI fallback. Supabase is the optional
# cloud/web control plane and is not required for local coding tasks.
#
# Public Supabase values from: RDS AI project -> Supabase Dashboard -> Connect.
# Docker deployments must also pass these as build arguments because Next.js
# freezes NEXT_PUBLIC_* values into the browser bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-endpoint.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Required only by the cloud/web API. Never package it into the desktop client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# OpenAI-compatible Chat Completions provider. Supported preset IDs:
# bailian-payg, bailian-coding-plan, minimax-cn-token-plan,
# minimax-global-token-plan, kimi-code, deepseek, glm-payg,
# glm-coding-plan, custom.
#
# Keep LLM_PROVIDER, LLM_BASE_URL, LLM_MODEL, and LLM_API_KEY on the same
# provider/product/region. Coding-plan and pay-as-you-go keys are not
# interchangeable. The desktop UI pins preset URLs; environment variables are
# trusted host configuration and must use the matching endpoint.
LLM_PROVIDER=bailian-payg
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-model-api-key
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096

# Runtime guardrails.
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_TOOL_CALLS=32
AGENT_MAX_TOOL_CONCURRENCY=4
AGENT_MAX_MODEL_OUTPUT_BYTES=1048576
AGENT_MAX_TOOL_ARGUMENT_BYTES=32768
AGENT_MAX_TOOL_RESULT_BYTES=65536
AGENT_TOOL_TIMEOUT_MS=15000
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_MAX_HISTORY_MESSAGES=40
AGENT_CONTEXT_WINDOW_TOKENS=32768

# Desktop local process boundary. Values are exact executable names; each write
# or execution still pauses for interactive approval.
DESKTOP_ALLOWED_EXECUTABLES=git,node,npm,pnpm,npx,yarn,bun,python,python3,pytest,cargo,go,make
DESKTOP_ENV_ALLOWLIST=PATH,LANG,LC_ALL

# Optional Alibaba Cloud RAG Agent integration.
# Set the endpoint origin only; the app appends /rag/v1/...
ALIYUN_RAG_BASE_URL=
ALIYUN_RAG_API_KEY=
ALIYUN_RAG_DATASET_IDS=
ALIYUN_RAG_MODE=mix

# Optional managed RDS long-term memory. The app-owned table is the fallback.
MEM0_HOST=
MEM0_API_KEY=
MEM0_ENABLE_GRAPH=false

# Optional web search. Configure one provider; Tavily takes precedence.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Optional application settings.
NEXT_PUBLIC_APP_NAME=Brace
LOG_LEVEL=info
